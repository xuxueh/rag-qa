# ===== 复制为 .env 后按需修改（.env 不进 git）=====
# 大模型（必填，问答才需要；只做检索评测可以不填）
DEEPSEEK_API_KEY=sk-你的key
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_MODEL=deepseek-chat
LLM_TEMPERATURE=0

# 知识库目录（相对仓库根目录或绝对路径）
KNOWLEDGE_DIR=知识库

# 模型（本地目录或 ModelScope / HuggingFace 模型 ID）
# 本地下载示例：
#   modelscope download --model iic/nlp_gte_sentence-embedding_chinese-small --local_dir models/gte-small
#   modelscope download --model BAAI/bge-reranker-v2-m3 --local_dir models/bge-reranker-v2-m3
EMBEDDING_MODEL=models/gte-small
RERANK_MODEL=models/bge-reranker-v2-m3
USE_RERANK=1

# 检索超参（一般不用改）
CHUNK_SIZE=200
CHUNK_OVERLAP=20
RECALL_TOP_K=10
RERANK_TOP_N=3
RRF_K=60

# 服务
API_HOST=127.0.0.1
API_PORT=8000
MAX_UPLOAD_MB=20
LOG_LEVEL=INFO
